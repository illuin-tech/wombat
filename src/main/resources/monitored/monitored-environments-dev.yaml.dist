environments:
  # Map key and `id` must match: the key is how the file is indexed, `id` is what core.asset.Environment carries
  # and what assets reference through `environment-id`.
  preprod:
    id: preprod
    assets:
      - type: tech.illuin.wombat-module.kubernetes-api
        id: my-cluster
        environment-id: preprod
        name: My cluster (preprod)
        namespace: my-namespace
        config-path: /path/to/kubeconfig
        heartbeat-skip: 1
        resolvers:
          cost: random
        profile:
          provider: aws
          instance-type: c5a.4xlarge
          location: FRA
          lifespan: 43800  # hours
      - type: tech.illuin.wombat-module.llm-static
        id: my-llm
        environment-id: preprod
        name: My LLM (preprod)
        resolvers:
          cost: csv-my-llm-a-con
        profile:
          models:
            - provider: mistralai
              model: mistral-large-latest
              location: FRA
              request-profile:
                output-token-count: 500
                request-per-year: 1000000
