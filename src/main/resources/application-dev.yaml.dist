# Alternative PostgreSQL Datasource for dev:
# quarkus:
#   datasource:
#     db-kind: postgresql
#     username: wombat
#     password: wombat
#     jdbc:
#       url: "jdbc:postgresql://localhost:5432/wombat"

# Connector endpoints for local mock / stub services
connector:
  boavizta:
    uri: "http://localhost:5001/v1/"
  ecologits:
    uri: "http://localhost:5002/"

monitor:
  environments-file: monitored/monitored-environments-dev.yaml

# Fold sampling rows every 5 minutes instead of every hour, so fresh activity reaches the UI within minutes
# Keep the defaults in production, see doc/compaction.md
compaction:
  cron: "0 1/5 * * * ?" # a minute past every 5-minute window
  window: 5m
  delay: 30s

# Local S3 Backup setup (e.g. SeaweedFS service), only used by the SQLite backend: drop it when running on PostgreSQL
# backup:
#   enabled: true
#   cron: "0 0 * * * ?"  # hourly
#   s3:
#     key-prefix: sqlite/
#     endpoint: http://localhost:8333
#     bucket: wombat-bucket
#     region: us-east-1
#     access-key: admin
#     secret-key: secret

# Optional Secret resolution directory:
# wombat:
#   secret:
#     directory:
#       path: /secrets

"%oidc":
  quarkus:
    oidc:
      auth-server-url: https://your-idp.example.com
      client-id: <client-id>
      credentials:
        secret: <client-secret>
    http:
      auth:
        permission:
          dev-ui:
            policy: permit
            paths:
              - /q/dev/*
              - /q/dev-ui/*
