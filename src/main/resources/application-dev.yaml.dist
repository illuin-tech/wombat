# Alternative PostgreSQL Datasource for dev:
# quarkus:
#   datasource:
#     db-kind: postgresql
#     username: wombat
#     password: wombat
#     jdbc:
#       url: "jdbc:postgresql://localhost:5432/wombat"

# Connector endpoints for local mock / stub services
connector:
  boavizta:
    uri: "http://localhost:5001/v1/"
  ecologits:
    uri: "http://localhost:5002/"

monitor:
  environments-file: monitored/monitored-environments-dev.yaml

# Local S3 Backup setup (e.g. SeaweedFS service)
backup:
  enabled: true
  cron: "0 0 * * * ?"  # hourly
  s3:
    key-prefix: sqlite/
    endpoint: http://localhost:8333
    bucket: wombat-bucket
    access-key: admin
    secret-key: secret

# Optional Secret resolution directory:
# wombat:
#   secret:
#     directory:
#       path: /secrets
