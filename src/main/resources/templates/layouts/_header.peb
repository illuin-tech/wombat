<header class="header" id="header-root">
  <img src="/public/icons/wombat-large-mask.png" alt="Wombat" class="header-logo"/>
  <h1>Wombat &mdash; <span>Environmental Impact</span></h1>
  {% if env is defined %}
  <div class="header-meta"
       data-start="{{ env.timeRange.start | isoUtc }}" data-end="{{ env.timeRange.end | isoUtc }}"></div>
  {% endif %}
  {% if currentUser.authenticated %}
  <div class="header-user">
    <span class="header-user-name" title="{{ currentUser.name }}">{{ currentUser.name }}</span>
    <a class="header-logout" href="/logout" title="Sign out" aria-label="Sign out">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <path d="M16 17l5-5-5-5"/>
        <path d="M21 12H9"/>
      </svg>
    </a>
  </div>
  {% endif %}
  <span data-vue-theme></span>
</header>
