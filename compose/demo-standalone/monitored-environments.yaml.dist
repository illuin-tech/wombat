environments:
  demo:
    id: demo
    assets:
      # This type models static Kubernetes container workloads using superposed temporal scenarios.
      - type: tech.illuin.wombat-module.kubernetes-static
        id: demo-cluster
        environment-id: demo
        profile:
          provider: aws
          instance-type: c5.xlarge
          location: FRA
          lifespan: 5y
          node-count: 1
          zone-id: Europe/Paris
          scenarios:
            - type: constant
              load: 0.10
            - type: user_activity
              baseline-load: 0.10
              peak-load: 0.75
              opening-time: "08:00:00"
              closing-time: "18:00:00"
              jitter: 0.05
              applicability:
                days-of-week: [MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY]
            - type: batch_activity
              baseline-load: 0.0
              peak-load: 0.90
              trigger-time: "02:00:00"
              duration: PT2H
              smoothing: linear_ramp
      # This type models static LLM workloads using superposed temporal scenarios across multiple models.
      # It runs immediately out-of-the-box without requiring external API credentials.
      - type: tech.illuin.wombat-module.llm-static
        id: demo-llm
        environment-id: demo
        profile:
          zone-id: Europe/Paris
          models:
            # Interactive chat assistant model with diurnal user traffic (bell curve on weekdays, over a light baseline)
            - provider: mistralai
              model: mistral-large-latest
              location: FRA
              request-per-year: 1000000
              output-token-per-request: 400
              scenarios:
                - type: constant
                  level: 0.01  # nights and weekends, at a hundredth of the weekday peak
                - type: user_activity
                  opening-time: "08:00:00"
                  closing-time: "18:00:00"
                  curve: bell
                  jitter: 0.05
                  applicability:
                    days-of-week: [MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY]
            # Scheduled document/PDF batch extraction model running nocturnal processing jobs
            - provider: openai
              model: gpt-5.5-pro
              location: SWE
              request-per-year: 100000
              output-token-per-request: 2000
              scenarios:
                - type: batch_activity
                  trigger-time: "02:00:00"
                  duration: PT2H
                  smoothing: linear_ramp
      # Alternatively, monitor live clusters via the Kubernetes Metrics API (requires a kubeconfig in a secret source, see compose.yaml):
      # - type: tech.illuin.wombat-module.kubernetes-api
      #   id: prod-cluster
      #   environment-id: demo
      #   namespaces: # the namespaces you deployed your applications to, all of them when omitted
      #     - my-project-namespace
      #   kubeconfig-key: my-kube # the secret holding your kubeconfig, e.g. the file secrets/my-kube mounted in compose.yaml
      #   # Omit the profile to infer the hardware from the cluster, provided the kubeconfig can read its nodes, or else the
      #   # namespace's quotas or pods
      #   profile:
      #     provider: aws
      #     instance-type: c5.xlarge
      #     location: FRA
      #     lifespan: 5y
