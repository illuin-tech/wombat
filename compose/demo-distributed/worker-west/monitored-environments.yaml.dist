# Sampled by this worker, and declared to the aggregator, which evaluates the assets as owned by this worker.
environments:
  west:
    id: west
    assets:
      # Reads the cluster's metrics API with the kubeconfig at compose/demo-distributed/worker-west/secrets/kubeconfig-west
      - type: tech.illuin.wombat-module.kubernetes-api
        id: west-cluster
        environment-id: west
        kubeconfig-key: kubeconfig-west
        namespace: default
        profile:
          provider: aws
          instance-type: c5.xlarge
          location: FRA
          lifespan: 43800  # hours
